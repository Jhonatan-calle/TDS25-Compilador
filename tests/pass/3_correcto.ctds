program
{
    integer x = 2;
    integer inc(integer z)
    {
        return z + 1;
    }
    integer get_int() extern;
    void printInt(integer i) extern;
    void main()
    {
        integer y = 0;
        y = get_int();
        if (y == 1) then
        {
            printInt(y);
        }
        else
        {
            printInt(inc(y));
            return;
        }
    }
}
