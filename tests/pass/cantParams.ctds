program
{
    integer op(integer x ,
                integer y ,
                integer z,
                integer a,
                integer b,
                integer c,
                integer d) {
        return 1+x;
    }
    integer op2(integer x , integer y , integer z) {
        return (x + y)*z;
    }
    integer get_integer(){
        return 1;
    }
    void printInt(integer x) extern;
    integer main() {
        integer y = 0;
        y = op(1,2,3,4,5,6,7);
        y = op2(y,3,6);
        printInt(op2(y,3,6));
        if (y == 1) then
        {
            printInt(1);
        } else {
            printInt(0);
        }
        return -1;
    }
}
