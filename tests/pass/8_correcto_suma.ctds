program
{
  void eq_assert(integer expected, integer result) extern;
  void printInt(integer x) extern;
  void main()
  {
    // integer x = 0;
    // mov las 2 cosas al reg cpu
    // hacer suma
    // traer resultado a donde lo tenga q guardar
    integer y = 1;  // 8
    integer z = 2;  // 8*2
    integer w = 3;
    integer res = y + z + w;  // 8*3 el y + z me da otro offset
    printInt(res);
    eq_assert(res, 6);
    return;
  }
}
