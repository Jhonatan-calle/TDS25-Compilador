program
{
  integer whiletrue = 1;
  void main()
  {
    bool ifelse = true;
    void eq_assert(integer expected, integer result) extern;
    if (ifelse) then
    {
      return;
    }
    else
    {
      integer x = -2;
      integer y = --3;

      integer elsethen = -x - -y;
      // (-2) - -(--3)
