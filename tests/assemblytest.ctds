program
{
    integer inc(integer x) {
        return (x + 1)*5;
    }
    integer get_integer(){
        return 1;
    }
    void printInt(integer x) extern;
    void main() {
        integer y = 0;
        y = inc(get_integer());
        if (y == 1) then
        {
            printInt(1);
        } else {
            printInt(0);
        }
    }
}
